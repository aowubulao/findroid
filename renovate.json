{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Keep Jellyfin Server 10.10 compatibility",
      "matchPackageNames": [
        "org.jellyfin.sdk:*"
      ],
      "allowedVersions": ">=1.7.1 <1.8.0"
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/org.jetbrains.kotlin.*/",
        "/com.google.devtools.ksp/"
      ]
    }
  ]
}
